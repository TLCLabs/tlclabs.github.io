---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Welcome to TLC Labs</h1>
			<hr />
			<h2>Our Vision</h2>
			<p>
				<em>
					"To fundamentally improve the lives of people by creating a compassionate, employee-first
					business model, while building reliable open-source appliances that help eliminate
					e-waste"
				</em>{' '}
				- TLC Labs
			</p>
		</main>
		<Footer />
	</body>
</html>
